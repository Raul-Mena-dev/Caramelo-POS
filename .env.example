# Desarrollo local
POS_USE_SQLITE=1
POS_DEBUG=true
POS_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
POS_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL (omite POS_USE_SQLITE para usarlo)
POS_DB_NAME=caramelo_db
POS_DB_USER=caramelo_user
POS_DB_PASSWORD=
POS_DB_HOST=127.0.0.1
POS_DB_PORT=5433

# Demo separada (caramelo.settings_demo)
DATABASE_URL=postgresql://usuario:password@host:5432/base?sslmode=require
POS_DEMO_USERNAME=demo
POS_DEMO_PASSWORD=DemoPOS2026!
